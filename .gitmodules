[submodule "lib/N64ModernRuntime"]
	path = lib/N64ModernRuntime
	url = https://github.com/N64Recomp/N64ModernRuntime
[submodule "lib/rt64"]
	path = lib/rt64
	url = https://github.com/rt64/rt64
	ignore = dirty
[submodule "lib/RecompFrontend"]
	path = lib/RecompFrontend
	url = https://github.com/N64Recomp/RecompFrontend
[submodule "lib/mp1-decomp"]
	path = lib/mp1-decomp
	url = https://github.com/mariopartyrd/marioparty
[submodule "lib/mp2-decomp"]
	path = lib/mp2-decomp
	url = https://github.com/mariopartyrd/marioparty2
[submodule "lib/mp3-decomp"]
	path = lib/mp3-decomp
	url = https://github.com/mariopartyrd/marioparty3
