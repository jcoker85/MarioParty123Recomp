+void players::enable_auto_assignment() {
+    PlayerState.auto_assignment = true;
+    PlayerState.players = PlayerArray{};
+    PlayerState.players.add_keyboard_player();
+
+    // Player 1 keeps the SP profiles. Unset profile indices default to 0, which is the SP keyboard
+    // profile, so every other player must be cleared or the keyboard would drive them too.
+    for (int i = 1; i < (int)max_num_players_supported; i++) {
+        profiles::set_input_profile_for_player(i, -1, InputDevice::Keyboard);
+        profiles::set_input_profile_for_player(i, -1, InputDevice::Controller);
+    }
+}
+
+void players::auto_assign_controller(SDL_GameController* controller) {
+    if (!PlayerState.auto_assignment || PlayerState.is_assigning || controller == nullptr) {
+        return;
+    }
+
+    PlayerArray& assigned = PlayerState.players;
+    int slot = -1;
+    for (int i = 0; i < (int)assigned.get_count(); i++) {
+        if (assigned[i].controller == controller) {
+            return;
+        }
+        if (slot < 0 && assigned[i].controller == nullptr) {
+            slot = i;
+        }
+    }
+
+    if (slot >= 0) {
+        assigned[slot].controller = controller;
+        assigned[slot].button_pressed();
+    } else if (assigned.get_count() < PlayerState.max_players) {
+        slot = (int)assigned.get_count();
+        assigned.add_controller_player(controller);
+    } else {
+        return;
+    }
+
+    if (slot > 0) {
+        profiles::set_input_profile_for_player(slot, profiles::get_controller_profile_index_from_sdl_controller(controller), InputDevice::Controller);
+    }
+    printf("Controller assigned to player %d\n", slot + 1);
+}
+
+void players::auto_unassign_controller(SDL_GameController* controller) {
+    if (!PlayerState.auto_assignment || controller == nullptr) {
+        return;
+    }
+
+    PlayerArray& assigned = PlayerState.players;
+    for (int i = 0; i < (int)assigned.get_count(); i++) {
+        if (assigned[i].controller == controller) {
+            assigned[i].controller = nullptr;
+            if (i > 0) {
+                profiles::set_input_profile_for_player(i, -1, InputDevice::Controller);
+            }
+            assigned.trim_unused();
+            printf("Controller removed from player %d\n", i + 1);
+            return;
+        }
+    }
+}
+
 bool players::has_enough_players_assigned() {
     return PlayerState.players.get_count() >= PlayerState.min_players;
 }
